# Node Runtime Environment ('development' or 'production')
NODE_ENV=production

# Application Server Port
PORT=5000

# Client Application URL for strict CORS allowlisting (comma-separated origins)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://ajjewellers.in,https://www.ajjewellers.in

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aj-jewellers?retryWrites=true&w=majority

# Strong Cryptographic Secret for JWT Authentication (Minimum 32 random characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_production_jwt_secret_here

# Transactional Email Settings (Nodemailer SMTP / Resend / SendGrid)
EMAIL_USER=your_verified_email@example.com
EMAIL_PASS=your_email_app_password_or_smtp_key
NOREPLY_EMAIL=no-reply@ajjewellers.in

# DNS Override (Optional: set to 'true' only if ISP blocks Atlas DNS in local development)
FORCE_GOOGLE_DNS=false
