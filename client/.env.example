# Backend API Base URL
# For local development: http://localhost:5000
# For production: https://api.ajjewellers.in
VITE_API_BASE=http://localhost:5000

# Google Maps Platform API Key
# Prototyping: Mint a free key at https://mapsplatform.google.com/maps-demo-key
# Production: Create & restrict key at https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
